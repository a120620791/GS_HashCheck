<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HashCheck</AssemblyName>
    <RootNamespace>HashCheck</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Hash 校验工具</Product>
    <AssemblyTitle>Hash 校验工具</AssemblyTitle>
    <Description>文件哈希校验与对比：MD5 / SHA-1 / SHA-256 / SHA-512 / SHA-3 / BLAKE3</Description>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blake3" Version="3.0.2" />
  </ItemGroup>

  <!-- BLAKE3 依赖由 dotnet add package Blake3 写入（.NET 未内置 BLAKE3） -->

</Project>